    # The user's total number of available budgets
    @jsondata:Name {value: "available_budgets"}
    int availableBudgets?;
    # The day of the week the user wishes their calendars to start on. A number between 0 and 6, where 0 is Sunday and 6 is Saturday
    @jsondata:Name {value: "week_start_day"}
    int weekStartDay?;
    # Whether the user has opted in to beta features
    @jsondata:Name {value: "beta_user"}
    boolean betaUser?;
    # The date that the user's forecast starts
    @jsondata:Name {value: "forecast_start_date"}
    string forecastStartDate?;
    # When the user signed up
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # Whether the user's forecast recalculation should be deferred
    @jsondata:Name {value: "forecast_defer_recalculate"}
    boolean forecastDeferRecalculate?;
    # The user's username
    string login?;
    # The user's time zone
    @jsondata:Name {value: "time_zone"}
    string timeZone?;
    # The date that the user's forecast ends
    @jsondata:Name {value: "forecast_end_date"}
    string forecastEndDate?;
    # When the user last logged into PocketSmith
    @jsondata:Name {value: "last_logged_in_at"}
    string lastLoggedInAt?;
    # Whether the user wants to see all accounts in their base currency instead of the native account currency
    @jsondata:Name {value: "always_show_base_currency"}
    boolean alwaysShowBaseCurrency?;
    # The URL to the user's avatar
    @jsondata:Name {value: "avatar_url"}
    string avatarUrl?;
    # When the user was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # When the user last interacted with PocketSmith, via any application or the API
    @jsondata:Name {value: "last_activity_at"}
    string lastActivityAt?;
    # The full name of the user, although not all users will have a name set
    string name?;
    # When the user's forecast was last updated
    @jsondata:Name {value: "forecast_last_updated_at"}
    string forecastLastUpdatedAt?;
    # Whether the user has multiple currencies in use across their account
    @jsondata:Name {value: "using_multiple_currencies"}
    boolean usingMultipleCurrencies?;
    # The user's total number of available accounts
    @jsondata:Name {value: "available_accounts"}
    int availableAccounts?;
    # The unique identifier of the user
    int id?;
    # Whether the user's forecast needs to be recalculated
    @jsondata:Name {value: "forecast_needs_recalculate"}
    boolean forecastNeedsRecalculate?;
    # The user's base currency
    @jsondata:Name {value: "base_currency_code"}
    string baseCurrencyCode?;
    # The user's email address
    string email?;
    # Whether the user wants to review new transactions, transfer transactions or categorisation
    @jsondata:Name {value: "is_reviewing_transactions"}
    boolean isReviewingTransactions?;
};

public type Category record {
    # The colour for the category
    string colour?;
    # When the category was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # The category's child categories
    Category[] children?;
    # The unique identifier of the parent category of this category, or null if this category has no parent (i.e. is a top-level category)
    @jsondata:Name {value: "parent_id"}
    int parentId?;
    # Whether the category is a bill category. A bill category is when budgeted amounts are normally spent at once, instead of spread across a budgeting period. This category will be included in the bill reminder email when set to true
    @jsondata:Name {value: "is_bill"}
    boolean isBill?;
    # Whether this category has been marked as a transfer category
    @jsondata:Name {value: "is_transfer"}
    boolean isTransfer?;
    # Whether the category's budget is rolled up into its parent category, if a parent category is present
    @jsondata:Name {value: "roll_up"}
    boolean rollUp?;
    # When the category was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The unique identifier of the category
    int id?;
    # The title of the category
    string title?;
    # How the category's refunds or deductions should be reported on
    @jsondata:Name {value: "refund_behaviour"}
    "debits_are_deductions"|"credits_are_refunds"? refundBehaviour?;
};

public type SavedSearch record {
    # When the saved search was last updated
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # When the saved search was created
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The unique identifier of the saved search
    int id?;
    # The title of the saved search
    string title?;
};

public type AssignAttachmentRequest record {
    # The unique identifier of the attachment
    @jsondata:Name {value: "attachment_id"}
    int attachmentId?;
};

public type TransactionAccount record {
    # The current safe balance, if safe balance is activated and available for the transaction account. If safe balance is not available, then null is returned
    @jsondata:Name {value: "safe_balance"}
    decimal safeBalance?;
    # The current balance of the transaction account in the user's base currency
    @jsondata:Name {value: "current_balance_in_base_currency"}
    decimal currentBalanceInBaseCurrency?;
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The type of the transaction account
    "bank"|"credits"|"cash"|"stocks"|"mortgage"|"loans"|"vehicle"|"property"|"insurance"|"other_asset"|"other_liability" 'type?;
    @jsondata:Name {value: "starting_balance"}
    decimal startingBalance?;
    # The currency that the account is in. This is determined by the account that the transaction account belongs to
    @jsondata:Name {value: "currency_code"}
    string currencyCode?;
    string number?;
    @jsondata:Name {value: "starting_balance_date"}
    string startingBalanceDate?;
    Institution institution?;
    @jsondata:Name {value: "current_balance_date"}
    string currentBalanceDate?;
    # The exchange rate between the transaction account's currency and the user's base currency, when different. If the currencies are the same, null is returned
    @jsondata:Name {value: "current_balance_exchange_rate"}
    decimal currentBalanceExchangeRate?;
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    string name?;
    @jsondata:Name {value: "current_balance"}
    decimal currentBalance?;
    # The current safe balance in the user's base currency, if safe balance is activated and available for the transaction account. If safe balance is not available, then null is returned
    @jsondata:Name {value: "safe_balance_in_base_currency"}
    decimal safeBalanceInBaseCurrency?;
    int id?;
};

# Response when splits are provided
public type TransactionSplitsResponse record {
    @jsondata:Name {value: "split_transactions"}
    Transaction[] splitTransactions;
    Transaction 'transaction;
};

public type UpdateEventRequest record {
    # A note for the event
    string note?;
    # The amount of the event. A positive amount is a credit, and a negative amount is a debit
    decimal amount?;
    # The repeat type of the event
    @jsondata:Name {value: "repeat_type"}
    "once"|"daily"|"weekly"|"fortnightly"|"monthly"|"yearly"|"each weekday" repeatType?;
    # Whether the update applies only to this event, to all events within the series from this event or to all events within the series
    "one"|"forward"|"all" behaviour;
    # The repeat interval of the event
    @jsondata:Name {value: "repeat_interval"}
    int repeatInterval?;
};

public type UpdateAccountsOrderRequest record {
    # List the account objects in their new display order
    Account[] accounts;
};

# OAuth2 Refresh Token Grant Configs
public type OAuth2RefreshTokenGrantConfig record {|
    *http:OAuth2RefreshTokenGrantConfig;
    # Refresh URL
    string refreshUrl = "https://api.pocketsmith.com/v2/oauth/access_token";
|};

# Represents the Queries record for the operation: deleteEvent
public type DeleteEventQueries record {
    # Whether the delete applies only to this event, to all events within the series from this event or to all events within the series
    "one"|"forward"|"all" behaviour;
};

public type AttachmentContentTypeMeta record {
    # The extension type of the attachment
    string extension?;
    # The content type description of the attachment
    string description?;
    # The content type title of the attachment
    string title?;
};

# Represents the Queries record for the operation: listUserTransactions
public type ListUserTransactionsQueries record {
    # Limit to transactions on or before this date. Required if start_date is provided. If not provided, defaults to today's date
    @http:Query {name: "end_date"}
    string endDate?;
    # Limit to transactions that need to be reviewed
    @http:Query {name: "needs_review"}
    int needsReview?;
    # Limit to transactions matching a keyword search string. The provided string is matched against the transaction amount, account name, payee, category title, note, labels, and the date in ISO 8601 format
    string search?;
    # Limit to uncategorised transactions
    int uncategorised?;
    # Limit to transactions updated since an ISO 8601 timestamp
    @http:Query {name: "updated_since"}
    string updatedSince?;
    # Choose a particular page of the results
    int page?;
    # Limit to transactions of this type
    "debit"|"credit" 'type?;
    # Limit to transactions on or after this date. Required if end_date is provided. If not provided, defaults to the furtherest date allowed by the user's subscription
    @http:Query {name: "start_date"}
    string startDate?;
};

# Represents the Queries record for the operation: getUserBudget
public type GetUserBudgetQueries record {
    # Whether parent categories should have their children rolled up into them. When used, the children will still appear in the collection on their own, but their actual and forecast figures will be rolled up to the root parent
    @http:Query {name: "roll_up"}
    boolean rollUp?;
};

public type BudgetAnalysis record {
    # The end date of the budget analysis
    @jsondata:Name {value: "end_date"}
    string endDate?;
    # The average budgeted amount across all periods
    @jsondata:Name {value: "average_forecast_amount"}
    decimal averageForecastAmount?;
    # The period analyses that this budget analysis comprises
    Period[] periods?;
    # The total amount the budget was exceeded across all periods
    @jsondata:Name {value: "total_over_by"}
    decimal totalOverBy?;
    # The total actual (transactions) amount across all periods
    @jsondata:Name {value: "total_actual_amount"}
    decimal totalActualAmount?;
    # The average actual (transactions) amount across all periods
    @jsondata:Name {value: "average_actual_amount"}
    decimal averageActualAmount?;
    # The total budgeted amount across all periods
    @jsondata:Name {value: "total_forecast_amount"}
    decimal totalForecastAmount?;
    # The currency of the budget analysis
    @jsondata:Name {value: "currency_code"}
    string currencyCode?;
    # The start date of the budget analysis
    @jsondata:Name {value: "start_date"}
    string startDate?;
    # The total amount the budget was under by across all periods
    @jsondata:Name {value: "total_under_by"}
    decimal totalUnderBy?;
};

# Represents the Queries record for the operation: listTransactionAccountTransactions
public type ListTransactionAccountTransactionsQueries record {
    # Limit to transactions on or before this date. Required if start_date is provided. If not provided, defaults to today's date
    @http:Query {name: "end_date"}
    string endDate?;
    # Limit to transactions that need to be reviewed
    @http:Query {name: "needs_review"}
    int needsReview?;
    # Limit to transactions matching a keyword search string. The provided string is matched against the transaction amount, account name, payee, category title, note, labels, and the date in ISO 8601 format
    string search?;
    # Limit to uncategorised transactions
    int uncategorised?;
    # Limit to transactions updated since an ISO 8601 timestamp
    @http:Query {name: "updated_since"}
    string updatedSince?;
    # Choose a particular page of the results
    int page?;
    # Limit to transactions of this type
    "debit"|"credit" 'type?;
    # Limit to transactions on or after this date. Required if end_date is provided. If not provided, defaults to the furtherest date allowed by the user's subscription
    @http:Query {name: "start_date"}
    string startDate?;
};

# Represents the Queries record for the operation: listScenarioEvents
public type ListScenarioEventsQueries record {
    # Return the events until and including this date
    @http:Query {name: "end_date"}
    string endDate;
    # Return the events from and including this date
    @http:Query {name: "start_date"}
    string startDate;
};

public type BudgetAnalysisPackage record {
    BudgetAnalysis income?;
    # Whether the expense budget analysis looks like a transfer to the income budget analysis, based on a number of heuristics
    @jsondata:Name {value: "is_transfer"}
    boolean isTransfer?;
    Category category?;
    BudgetAnalysis expense?;
};

# Represents the Queries record for the operation: listUserAttachments
public type ListUserAttachmentsQueries record {
    # If set, returns unassigned attachments, that are available for assigning to a transaction
    int unassigned?;
};

public type CreateAccountRequest record {
    # A title for the account
    string title;
    # The type of the account
    "bank"|"credits"|"cash"|"loans"|"mortgage"|"stocks"|"vehicle"|"property"|"insurance"|"other_asset"|"other_liability" 'type;
    # A currency code for the account
    @jsondata:Name {value: "currency_code"}
    string currencyCode;
    # The ID of the institution to create this account in
    @jsondata:Name {value: "institution_id"}
    int institutionId;
};

# Represents the Queries record for the operation: deleteInstitution
public type DeleteInstitutionQueries record {
    # The unique identifier of the institution to merge into
    @http:Query {name: "merge_into_institution_id"}
    int mergeIntoInstitutionId?;
};

public type CreateInstitutionRequest record {
    # A title for the institution
    string title;
    # A currency code for the institution
    @jsondata:Name {value: "currency_code"}
    string currencyCode;
};

public type Event record {
    # The date of the event
    string date?;
    # The note of the event
    string note?;
    # The unique identifier of the series followed by the series's start date
    @jsondata:Name {value: "series_start_id"}
    string seriesStartId?;
    # The amount of the event
    decimal amount?;
    # The repeat type of the event
    @jsondata:Name {value: "repeat_type"}
    "once"|"daily"|"weekly"|"fortnightly"|"monthly"|"yearly"|"each weekday" repeatType?;
    # Whether the event repeats and does not have an end date
    @jsondata:Name {value: "infinite_series"}
    boolean infiniteSeries?;
    # The amount of the event in the user's base currency
    @jsondata:Name {value: "amount_in_base_currency"}
    decimal amountInBaseCurrency?;
    # The currency code of the event
    @jsondata:Name {value: "currency_code"}
    string currencyCode?;
    # The unique identifier of the series that the event belongs to
    @jsondata:Name {value: "series_id"}
    int seriesId?;
    # The CSS hex-style colour of the event
    string colour?;
    Scenario scenario?;
    # The repeat interval of how often the event takes place
    @jsondata:Name {value: "repeat_interval"}
    int repeatInterval?;
    # The unique identifier of the event
    string id?;
    Category category?;
};

public type AttachmentVariants record {
    # The url of the thumb version of the attachment
    @jsondata:Name {value: "thumb_url"}
    string thumbUrl?;
    # The url of the large version of the attachment
    @jsondata:Name {value: "large_url"}
    string largeUrl?;
};

public type CreateAttachmentRequest record {
    # The file name of the attachment
    @jsondata:Name {value: "file_name"}
    string fileName?;
    # The title of the attachment. If the title is blank or not provided, the title will derived from the file name
    string title?;
    # The base64-encoded contents of the source file. The supported file types are png, jpg, pdf, xls, xlsx, doc, docx
    @jsondata:Name {value: "file_data"}
    string fileData?;
};

